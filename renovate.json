{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "//": [
    "2026-07-27 起停用。原因：Renovate 與 Dependabot 兩套並行，同一個漏洞會各開",
    "一份 PR（例：dompurify 3.4.12 同時有 renovate/npm-dompurify-vulnerability 與",
    "dependabot/npm_and_yarn/dompurify-3.4.12），且 5 個 renovate PR 全部修改同一個",
    "package-lock.json，逐一合併必然連環衝突。",
    "",
    "下方設定全數保留，恢復時把 enabled 改回 true 即可。",
    "改為人工定期升級：npm audit 與 npm outdated，處理後走一般 PR 流程。",
    "CVE 可見度由 CI 的依賴掃描 gate 維持（見 .github/workflows/ci.yml 的 audit job",
    "與 .github/audit-allowlist.json），不依賴 bot 開 PR 才知道有漏洞。"
  ],
  "enabled": false,
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":timezone(Asia/Taipei)"
  ],
  "schedule": ["before 9am on monday"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rangeStrategy": "bump",
  "labels": ["dependencies", "frontend"],
  "rebaseWhen": "behind-base-branch",
  "commitMessagePrefix": "chore(deps):",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on thursday"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"],
    "schedule": null,
    "prCreation": "immediate"
  },
  "packageRules": [
    {
      "description": "patch / pin / digest 自動合併（CI 綠燈就合）",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "核心執行時 major 走人工（vue / vite / element-plus / liff / chart 系列）",
      "matchPackageNames": [
        "vue",
        "vue-router",
        "pinia",
        "@vue/test-utils",
        "vite",
        "@vitejs/plugin-vue",
        "element-plus",
        "@line/liff",
        "chart.js",
        "vue-chartjs",
        "echarts"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "vite-plugin-pwa 保守：只接 patch（pre-existing transitive CVE 不主動 minor/major）",
      "matchPackageNames": ["vite-plugin-pwa"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "groupName": "sentry 套件",
      "matchPackageNames": ["@sentry/vue", "@sentry/vite-plugin"]
    },
    {
      "groupName": "vue 套件",
      "matchPackageNames": ["vue", "vue-router", "pinia", "@vue/test-utils"]
    },
    {
      "groupName": "vite 套件",
      "matchPackageNames": ["vite", "@vitejs/plugin-vue", "vite-plugin-pwa"]
    },
    {
      "groupName": "vitest 套件",
      "matchPackageNames": ["vitest", "@vitest/coverage-v8"]
    },
    {
      "groupName": "testing 工具",
      "matchPackageNames": ["happy-dom", "jsdom", "axios-mock-adapter", "fake-indexeddb"]
    },
    {
      "groupName": "unplugin 套件",
      "matchPackageNames": ["unplugin-auto-import", "unplugin-vue-components"]
    },
    {
      "groupName": "chart 套件",
      "matchPackageNames": ["chart.js", "vue-chartjs", "echarts"]
    }
  ]
}
