{
    "name": "frontend-vue",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build && node scripts/check-entry-chunks.mjs",
        "postbuild": "find dist -name '*.map' -type f -delete 2>/dev/null; true",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "vue-tsc --noEmit",
        "typecheck:watch": "vue-tsc --noEmit --watch",
        "parent:audit": "bash scripts/parent-audit-grep.sh",
        "gen:m3-tokens": "node scripts/gen-m3-tokens.mjs > src/parent/styles/m3-tokens.css",
        "gen:api": "openapi-typescript ../ivy-backend/openapi.json -o src/api/_generated/schema.d.ts --alphabetize",
        "gen:api:check": "npm run gen:api && node scripts/check-api-drift.mjs",
        "check:shared-constants": "node scripts/check-shared-constants.mjs",
        "lint": "eslint .",
        "lint:css": "stylelint 'src/**/*.{css,vue}'",
        "lint:tokens": "node scripts/lint-tokens.mjs",
        "check:error-detail": "node scripts/check-error-detail-ratchet.mjs"
    },
    "dependencies": {
        "@element-plus/icons-vue": "^2.3.2",
        "@fullcalendar/core": "^6.1.21",
        "@fullcalendar/daygrid": "^6.1.21",
        "@fullcalendar/interaction": "^6.1.21",
        "@fullcalendar/list": "^6.1.21",
        "@fullcalendar/timegrid": "^6.1.21",
        "@fullcalendar/vue3": "^6.1.21",
        "@line/liff": "^2.29.1",
        "@sentry/vue": "^10.62.0",
        "@vueuse/core": "^10.11.1",
        "axios": "^1.18.1",
        "chart.js": "^4.5.1",
        "dompurify": "^3.4.11",
        "element-plus": "^2.5.6",
        "idb": "^8.0.3",
        "leaflet": "^1.9.4",
        "leaflet.markercluster": "^1.5.3",
        "marked": "^18.0.7",
        "mitt": "^3.0.1",
        "pinia": "^3.0.4",
        "qrcode": "^1.5.4",
        "vue": "^3.5.39",
        "vue-chartjs": "^5.3.3",
        "vue-router": "^5.1.0",
        "vuedraggable": "^4.1.0"
    },
    "devDependencies": {
        "@csstools/postcss-global-data": "^4.0.0",
        "@material/material-color-utilities": "^0.4.0",
        "@sentry/vite-plugin": "^5.3.0",
        "@types/node": "^22.20.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/coverage-v8": "^4.1.9",
        "@vue/test-utils": "^2.4.11",
        "@vue/tsconfig": "^0.6.0",
        "axios-mock-adapter": "^2.1.0",
        "eslint": "^10.4.1",
        "eslint-plugin-vue": "^10.9.2",
        "fake-indexeddb": "^6.2.5",
        "globals": "^17.6.0",
        "happy-dom": "^20.6.1",
        "jsdom": "^29.1.1",
        "openapi-typescript": "^7.13.0",
        "postcss": "^8.5.23",
        "postcss-custom-media": "^12.0.1",
        "postcss-html": "^1.8.1",
        "sass": "^1.101.0",
        "stylelint": "^16.26.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.60.1",
        "unplugin-auto-import": "^21.0.0",
        "unplugin-vue-components": "^32.1.0",
        "vite": "^7.3.6",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.0.18",
        "vue-tsc": "^2.2.12"
    },
    "overrides": {
        "brace-expansion": "^5.0.8"
    }
}
