# ─── 多租戶品牌注入（fb §3.3）───────────────────────────────────────────────
# `$tb_*` 變數與 `$tb_known_host` 由 /etc/nginx/conf.d/00-tenant-brand.conf 定義
# （scripts/gen-tenant-brand-conf.mjs 從 branding/tenants.json 產生，`00-` 前綴保證
# 先於本檔載入）。本檔只負責「怎麼用」，不含任何品牌字面值。
#
# ⚠ envsubst 注意：nginx 官方 entrypoint 只替換「實際存在於環境變數」的名稱，
# 因此 $host / $uri / $scheme / $tb_* 都會原樣保留；${BACKEND_URL} 與
# ${TENANT_HOST_GUARD} 則必須在 Dockerfile 以 ENV 給預設值，否則不會被替換。
#
# 未知 host 守衛（scan-frontend GAP-13）：TENANT_HOST_GUARD=on 且 host 不在
# tenants.json 內時整站回 404。目的是讓任何指到本 IP 的 host（攻擊者自建 DNS、
# CDN 誤配、直連 IP）拿不到某一間真實園所的 og:site_name / 校名 / 海報。
# ⚠ 平台健康檢查用的 host 必須先列進 branding/tenants.json，否則部署會被自己擋掉。
map "${TENANT_HOST_GUARD}:$tb_known_host" $tb_reject_host {
    default 0;
    "on:0"  1;
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    if ($tb_reject_host) { return 404; }

    # ── Railway 私有網路 DNS 動態解析（修 upstream IP 快取斷線）──
    # ivy-api 每次重部署會換內網 IP，而 nginx 預設在啟動時解析 upstream hostname
    # 一次並永久快取 → api 換 IP 後 nginx 續連舊死 IP → /api 全 502（首頁靜態仍
    # 200，易誤判為 DB 問題）。加 resolver ＋下方 location 的變數化 proxy_pass 強制
    # 每請求重新解析，api 重部署後不必手動 redeploy 前端。
    # fd12::10 = Railway 內部 DNS（容器 /etc/resolv.conf 的 nameserver，私有網路為
    # IPv6）；valid=10s 每 10 秒重查一次。此值為 Railway 平台常數，非本專案專屬。
    resolver [fd12::10] valid=10s;
    resolver_timeout 5s;

    # ── 品牌注入：server 層宣告一次，所有 location 繼承 ──
    # HTML 檔 <5KB 且本就 no-cache，逐請求替換成本可忽略；/assets/ 的 js/css 因
    # type 不在 sub_filter_types 而完全不受影響。
    # ⛔ 不得改用 gzip_static 預壓縮 .gz：sub_filter 無法處理已壓縮的 body，token 會
    #    原樣外洩到使用者畫面（scripts/check-brand-tokens.mjs 有 gzip 斷言把關）。
    sub_filter_once off;
    sub_filter_types application/manifest+json;   # text/html 為隱含預設
    sub_filter '{{TB_ADMIN_TITLE}}'           $tb_admin_title;
    sub_filter '{{TB_PORTAL_TITLE}}'          $tb_portal_title;
    sub_filter '{{TB_PARENT_TITLE}}'          $tb_parent_title;
    sub_filter '{{TB_PUBLIC_TITLE}}'          $tb_public_title;
    sub_filter '{{TB_ORG_NAME}}'              $tb_org_name;
    sub_filter '{{TB_META_DESC}}'             $tb_meta_desc;
    sub_filter '{{TB_OG_DESC}}'               $tb_og_desc;
    sub_filter '{{TB_POSTER_ALT}}'            $tb_poster_alt;
    sub_filter '{{TB_OG_POSTER_V}}'           $tb_og_poster_v;
    sub_filter '{{TB_THEME_ADMIN}}'           $tb_theme_admin;
    sub_filter '{{TB_THEME_PARENT}}'          $tb_theme_parent;
    sub_filter '{{TB_MANIFEST_ADMIN_NAME}}'   $tb_manifest_admin_name;
    sub_filter '{{TB_MANIFEST_ADMIN_SHORT}}'  $tb_manifest_admin_short;
    sub_filter '{{TB_MANIFEST_ADMIN_DESC}}'   $tb_manifest_admin_desc;
    sub_filter '{{TB_MANIFEST_PARENT_NAME}}'  $tb_manifest_parent_name;
    sub_filter '{{TB_MANIFEST_PARENT_SHORT}}' $tb_manifest_parent_short;
    sub_filter '{{TB_MANIFEST_PARENT_DESC}}'  $tb_manifest_parent_desc;
    sub_filter '{{TB_MANIFEST_PUBLIC_NAME}}'  $tb_manifest_public_name;
    sub_filter '{{TB_MANIFEST_PUBLIC_SHORT}}' $tb_manifest_public_short;
    sub_filter '{{TB_MANIFEST_PUBLIC_DESC}}'  $tb_manifest_public_desc;
    # CT-F-09：不寫死 https，dev/staging 走 http 也要正確
    sub_filter '{{TB_ORIGIN}}'                '$scheme://$host';

    # gzip 靜態資源（sub_filter 在 gzip 壓縮之前執行，兩者相容）
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types
        text/plain text/css text/javascript
        application/javascript application/json
        application/manifest+json image/svg+xml;

    # /api/* 反代到後端（內部網路）— 讓 cookie 變 first-party，
    # 解 LIFF in-app webview 第三方 cookie 被 ITP 擋的問題。
    # BACKEND_URL 由 Zeabur frontend service 注入：
    #   http://ivymanagesystem-backend-rulla.zeabur.internal:8080
    # WS 走 upgrade，HTTP 走標準反代
    location /api/ws/ {
        # 變數化 proxy_pass 強制走 server 段的 resolver 動態解析（見上方說明）。
        # $ivy_api_backend 不含 URI 路徑 → nginx 以原始 $request_uri 透傳，語義同原
        # ${BACKEND_URL}/api/ws/（location 前綴＝後端路徑，本就是透傳）。
        set $ivy_api_backend "${BACKEND_URL}";
        proxy_pass $ivy_api_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/ {
        # 變數化 proxy_pass 強制走 server 段的 resolver 動態解析（見上方說明）。
        set $ivy_api_backend "${BACKEND_URL}";
        proxy_pass $ivy_api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        # 上傳上限對齊後端硬上限（utils/file_upload.py：一般 10MB / 影片 50MB）。
        # 未設時 nginx 預設 1m，>1MB 上傳（醫療照片、附件、Excel 匯入）會在
        # nginx 層 413，永遠打不到後端；細粒度 10MB 限制仍由後端執行（JSON 413）。
        client_max_body_size 50m;
        # 顯式釘住預設值：前端 axios timeout 30s < 此值，逾時語意由 axios 主導。
        proxy_read_timeout 60s;
    }

    # ── 必須每次 revalidate 的檔案（PWA 推不下去就是這幾個快取太兇） ──
    location = /index.html {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }
    location = /parent.html {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }
    location = /public.html {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }
    location = /sw.js {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }
    location = /registerSW.js {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }
    # 三份 manifest 全部顯式列出（改造前只有 /manifest.webmanifest 有）：
    # 它們現在帶 {{TB_*}} token，必須 no-cache 才能讓改品牌後的注入結果傳得出去。
    location = /manifest.webmanifest {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        types { } default_type application/manifest+json;
    }
    location = /parent.webmanifest {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        types { } default_type application/manifest+json;
    }
    location = /public.webmanifest {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        types { } default_type application/manifest+json;
    }
    # brand-version.json：內容 = branding/tenants.json 的 hash，被 SW precache
    # （CT-F-04）。改品牌值 → hash 變 → precache revision 變 → 已安裝 PWA 重抓
    # 三個 HTML。必須 no-cache，否則瀏覽器快取會讓這條機制延遲生效。
    location = /brand-version.json {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # ── L3 品牌資產 overlay：URL 不變，per-tenant 檔案優先、缺檔 fallback 預設檔 ──
    # /LOGO.png 等被 HTML、Vue template、SW precache、manifest 四處引用；讓 nginx 依
    # $host 換檔案內容，所有引用點零改動。租戶可以只覆蓋 logo，其餘自動吃預設檔。
    location ~ ^/(LOGO\.png|logo\.svg|favicon\.ico|apple-touch-icon-180x180\.png|pwa-(64x64|192x192|512x512)\.png|maskable-icon-512x512\.png|parent-(pwa-(192x192|512x512)|maskable-512x512)\.png|images/(activity-poster\.jpg|login-logo\.png|ivy-kids-loading\.png))$ {
        include /etc/nginx/security-headers.conf;
        # CT-F-09：短快取而非 no-cache——SW 的 StaleWhileRevalidate 仍能拿到更新，
        # 而首訪公開報名頁的訪客不必為每張圖多一次 revalidate。
        add_header Cache-Control "max-age=300" always;
        try_files /brand/$tb_slug$uri $uri =404;
    }

    # ── 帶 hash 的靜態資源：永久 cache ──
    location /assets/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # ── 其他檔案（含 public.html）：交給 nginx 預設行為（hash routing 不需 SPA fallback） ──
    location / {
        include /etc/nginx/security-headers.conf;
        try_files $uri $uri/ =404;
    }
}
